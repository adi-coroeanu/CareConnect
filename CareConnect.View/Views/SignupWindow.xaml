<Window x:Class="CareConnect.View.Views.SignupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CareConnect.View.Views"
        mc:Ignorable="d"
        xmlns:viewmodels="clr-namespace:CareConnect.WPF.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:SignupViewModel, IsDesignTimeCreatable=False}"
        Title="Signup" Height="500" Width="800">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/login-signupPhoto.jpg" Stretch="UniformToFill" />
        </Grid.Background>
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Height="Auto" Width="250">
            <Border CornerRadius="20" Background="White">
                <StackPanel Margin="10">
                    <TextBlock Text="Signup" HorizontalAlignment="Center" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Email" Margin="0 10 0 0"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="2"/>
                    <TextBlock Text="Email already used!" Foreground="Red" Visibility="{Binding EmailUsedError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="First name"/>
                    <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"  Padding="2"/>
                    <TextBlock Text="Last name"/>
                    <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Padding="2"/>
                    <TextBlock Text="Password" Margin="0 5 0 0"/>
                    <PasswordBox x:Name="PasswordBox" PasswordChanged="PasswordChanged" Padding="2"/>
                    <TextBlock Text="Incorrect password format!" Foreground="Red" Visibility="{Binding PasswordFormatError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="Re-enter password" Margin="0 5 0 0"/>
                    <PasswordBox x:Name="RepasswordBox" PasswordChanged="RepasswordChanged" Padding="2"/>
                    <TextBlock Text="Passwords don't match!" Foreground="Red" Visibility="{Binding PasswordMatchError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Grid Margin="0 5 0 0">
                        <TextBlock Text="Staff member? Enter code:" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding StaffCode}" HorizontalAlignment="Right" Width="80" Padding="2"/>
                    </Grid>
                    <TextBlock Text="Incorrect code!" Foreground="Red" Visibility="{Binding CodeError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="Sign up" Command="{Binding SignupCommand}" Padding="5" FontSize="15" Margin="0 10 0 0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
