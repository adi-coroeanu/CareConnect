<Window x:Class="CareConnect.View.Views.SignupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CareConnect.View.Views"
        mc:Ignorable="d"
        Title="Signup" Height="450" Width="800">
    <Grid Background="LightGray">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Height="300" Width="250">
            <Border CornerRadius="20" Background="White">
                <StackPanel Margin="10">
                    <TextBlock Text="Signup" HorizontalAlignment="Center" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Username" Margin="0 10 0 0"/>
                    <TextBox Padding="2"/>
                    <TextBlock Text="Username already exists!" Foreground="Red"/>
                    <TextBlock Text="Password" Margin="0 5 0 0"/>
                    <PasswordBox Padding="2"/>
                    <TextBlock Text="Password don't contain all symbols: Ab1#" Foreground="Red"/>
                    <TextBlock Text="Re-enter password" Margin="0 5 0 0"/>
                    <PasswordBox Padding="2"/>
                    <TextBlock Text="Passwords don't match!" Foreground="Red"/>
                    <Button Content="Sign up" Padding="5" FontSize="15" Margin="0 10 0 0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
