<Window x:Class="CareConnect.WPF.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CareConnect.WPF.Views"
        mc:Ignorable="d"
        xmlns:controls="clr-namespace:CareConnect.WPF.Views.UserControls"
        xmlns:viewmodels="clr-namespace:CareConnect.WPF.ViewModels"
        xmlns:controlsviewmodels="clr-namespace:CareConnect.WPF.ViewModels.UserControls"
        Title="Admin" WindowStartupLocation="CenterScreen" Height="750" Width="1100">
    <Window.Resources>
        <DataTemplate DataType="{x:Type controlsviewmodels:StatsAdminViewModel}">
            <controls:StatsAdminUserControl />
        </DataTemplate>
        <DataTemplate DataType="{x:Type controlsviewmodels:UsersAdminViewModel}">
            <controls:UsersAdminUserControl/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type controlsviewmodels:CodeAdminViewModel}">
            <controls:CodeAdminUserControl/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type controlsviewmodels:AuditAdminViewModel}">
            <controls:AuditAdminUserControl/>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#F0F4F8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="180"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="55"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#DDEAF5" BorderThickness="0 0 0 1">
                <Grid Margin="15 0">
                    <TextBlock Text="{Binding GreetingMessage}"
                               VerticalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#1A3C5E"/>
                    <Button Command="{Binding SignoutCommand}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="Sign out"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#1976D2"/>
                                <Setter Property="BorderBrush" Value="#1976D2"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Padding" Value="14 6"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E3F0FB"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentUserControlViewModel}" Margin="15"/>
        </Grid>

        <Border Grid.Column="1" Background="#1976D2" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#1565C0">
                    <TextBlock Text="CareConnect"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="White"/>
                </Border>

                <ListBox Grid.Row="1"
                         SelectedValuePath="Content"
                         SelectedValue="{Binding SelectedItemSideBar}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0 10 0 0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Foreground" Value="#DDEAF5"/>
                            <Setter Property="Padding" Value="20 12"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="Transparent"
                                                BorderThickness="3 0 0 0"
                                                BorderBrush="Transparent"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#1565C0"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#1565C0"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="White"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Content="Stats"/>
                    <ListBoxItem Content="Edit users"/>
                    <ListBoxItem Content="Generate code"/>
                    <ListBoxItem Content="Audit"/>
                    <ListBoxItem Content="Settings"/>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>