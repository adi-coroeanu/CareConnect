<UserControl x:Class="CareConnect.WPF.Views.UserControls.AuditAdminUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CareConnect.WPF.Views.UserControls"
             mc:Ignorable="d" 
             xmlns:controlsviewmodels="clr-namespace:CareConnect.WPF.ViewModels.UserControls"
             d:DataContext="{d:DesignInstance Type=controlsviewmodels:AuditAdminViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F4F6F9">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="150" MinHeight="300">
            <ListBox ItemsSource="{Binding AuditList}" SelectedItem="{Binding SelectedAuditDate}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
