<UserControl x:Class="CareConnect.WPF.Views.UserControls.HomeClientUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CareConnect.WPF.Views.UserControls"
             mc:Ignorable="d" 
             xmlns:controlsviewmodels="clr-namespace:CareConnect.WPF.ViewModels.UserControls"
             d:DataContext="{d:DesignInstance Type=controlsviewmodels:HomeClientViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F4F6F9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Column="0" Grid.Row="0" Text="Services" FontSize="20"/>
        <TextBlock Grid.Column="1" Grid.Row="0" Text="Free hours" FontSize="20" Margin="20 0 0 0"/>

        <DataGrid Grid.Column="0" Grid.Row="1" ItemsSource="{Binding ServicesList}" SelectedItem="{Binding SelectedService}" Margin="0 0 20 0" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Duration" Binding="{Binding EstTimeMinutes, StringFormat='{}{0} minutes'}" Width="*"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat='{}{0} lei'}" Width="*"/>
                <DataGridTextColumn Header="Operated by" Width="*">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0} {1}">
                            <Binding Path="IdDoctorNavigation.FirstName" />
                            <Binding Path="IdDoctorNavigation.LastName" />
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Column="0" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Select date:" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 5 0"/>
            <DatePicker Grid.Column="1" SelectedDate="{Binding SelectedDate}" VerticalAlignment="Center" Width="Auto" HorizontalAlignment="Left" Margin="5 0 0 0"/>
            <TextBlock Grid.Column="2" Text="Payment method" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 5 0"/>
            <ComboBox Grid.Column="3" SelectedValuePath="Content" SelectedValue="{Binding SelectedPaymentType}" VerticalAlignment="Center" Width="Auto" HorizontalAlignment="Stretch" Margin="5,0,20,0">
                <ComboBoxItem Content="Cash"/>
                <ComboBoxItem Content="Card"/>
            </ComboBox>
        </Grid>

        <ListBox Grid.Column="1" Grid.Row="1" ItemsSource="{Binding FreePeriodsList}" SelectedItem="{Binding SelectedPeriod}" Margin="20 0 0 0">

        </ListBox>
        <Button Grid.Column="1" Grid.Row="3" Command="{Binding MakeAppointmentCommand}" Content="Make appointment" HorizontalAlignment="Center" Padding="10" Margin="0 10 0 0"/>
    </Grid>
</UserControl>
