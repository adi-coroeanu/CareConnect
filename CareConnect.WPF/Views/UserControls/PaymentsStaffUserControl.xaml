<UserControl x:Class="CareConnect.WPF.Views.UserControls.PaymentsStaffUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CareConnect.WPF.Views.UserControls"
             mc:Ignorable="d" 
             xmlns:controlsviewmodels="clr-namespace:CareConnect.WPF.ViewModels.UserControls"
             d:DataContext="{d:DesignInstance Type=controlsviewmodels:PaymentsStaffViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Background="#F4F6F9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Column="0" Grid.Row="0" Text="Pending Payments" FontSize="20" VerticalAlignment="Center" Margin="5 0 0 0"/>
        <DataGrid Grid.Column="0" Grid.Row="1" ItemsSource="{Binding PendingPaymentsList}" SelectedItem="{Binding SelectedPendingPayment}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="5 0 0 0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Service" Binding="{Binding IdServiceNavigation.Name}" Width="*"/>
                <DataGridTextColumn Header="Date" Binding="{Binding BookingDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="*"/>
                <DataGridTextColumn Header="First name" Binding="{Binding IdUserNavigation.FirstName}" Width="*"/>
                <DataGridTextColumn Header="Last name" Binding="{Binding IdUserNavigation.LastName}" Width="*"/>
                <DataGridTextColumn Header="Ammount" Binding="{Binding TotalAmmount, StringFormat='{}{0} lei'}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Column="1" Grid.Row="1" Margin="5 0 0 0">
            <Border Background="LightCyan" VerticalAlignment="Center" CornerRadius="10" HorizontalAlignment="Center" Padding="5">
                <StackPanel>
                    <Grid Margin="0 10 0 5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Payment method" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 5 0"/>
                        <ComboBox Grid.Column="1" SelectedValuePath="Content" SelectedValue="{Binding SelectedPaymentMethod}" VerticalAlignment="Center" Width="Auto" HorizontalAlignment="Stretch" MinWidth="60" Margin="5,0,20,0">
                            <ComboBoxItem Content="Card"/>
                            <ComboBoxItem Content="Cash"/>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0 5 0 5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Amount (lei):" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 5 0"/>
                        <TextBox Text="{Binding AmmountValue, UpdateSourceTrigger=PropertyChanged}" Grid.Column="2" VerticalAlignment="Center" Margin="5 0 20 0"/>
                    </Grid>
                    <TextBlock Text="Invalid ammount!" Foreground="Red" HorizontalAlignment="Center" FontSize="10" Visibility="{Binding InvalidAmmountError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="Pay now" Command="{Binding PayCommand}" HorizontalAlignment="Center" Padding="10" Margin="0 10 0 10"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
