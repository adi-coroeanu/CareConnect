<UserControl x:Class="CareConnect.WPF.Views.UserControls.ServicesStaffUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CareConnect.WPF.Views.UserControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             xmlns:controlsviewmodels="clr-namespace:CareConnect.WPF.ViewModels.UserControls"
             d:DataContext="{d:DesignInstance Type=controlsviewmodels:ServicesStaffViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Background="#F4F6F9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Column="0" Grid.Row="0" Text="Your services" FontSize="20" VerticalAlignment="Center"/>
        <DataGrid Grid.Column="0" Grid.Row="1" ItemsSource="{Binding StaffServicesList}" SelectedItem="{Binding SelectedService}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Open time" Binding="{Binding TimeStart}" Width="*"/>
                <DataGridTextColumn Header="Close time" Binding="{Binding TimeEnd}" Width="*"/>
                <DataGridTextColumn Header="Duration" Binding="{Binding EstTimeMinutes, StringFormat='{}{0} minutes'}" Width="*"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat='{}{0} lei'}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Grid.Column="0" Command="{Binding DeleteServiceCommand}" Content="Delete service" HorizontalAlignment="Center" Padding="10" Margin="0 5 0 0"/>

        <TextBlock Grid.Row="0" Grid.Column="1" Text="Create service" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Grid Grid.Column="1" Grid.Row="1" Margin="5 0 0 0">
            <Border Background="LightCyan" VerticalAlignment="Top" HorizontalAlignment="Center" CornerRadius="10" Padding="10" Margin="0 20 0 0">
                <StackPanel>
                    <Grid Margin="0 10 0 5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name of service:" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 5 0"/>
                        <TextBox Grid.Column="1" Text="{Binding ServiceName, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="0 0 5 0" MinWidth="80"/>
                    </Grid>


                    <materialDesign:TimePicker Is24Hours="True" WithSeconds="False" SelectedTime="{Binding OpeningTime}" materialDesign:HintAssist.Hint="Select opening time" MinWidth="100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <materialDesign:TimePicker Is24Hours="True" WithSeconds="False" SelectedTime="{Binding ClosingTime}" materialDesign:HintAssist.Hint="Select closing time" MinWidth="100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Grid Margin="0 5 0 5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Minutes per appointment:" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 5 0"/>
                        <TextBox Text="{Binding MinutesAppointment, UpdateSourceTrigger=PropertyChanged}" Grid.Column="2" VerticalAlignment="Center" Margin="5 0 20 0" MinWidth="50"/>
                    </Grid>
                    <TextBlock Text="Invalid minutes!" Foreground="Red" HorizontalAlignment="Center" Visibility="{Binding InvalidMinutesError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Grid Margin="0 5 0 5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Price (lei): " HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 5 0"/>
                        <TextBox Text="{Binding ServicePrice, UpdateSourceTrigger=PropertyChanged}" Grid.Column="2" VerticalAlignment="Center" Margin="5 0 20 0" MinWidth="50"/>
                    </Grid>
                    <TextBlock Text="Invalid price!" Foreground="Red" HorizontalAlignment="Center" Visibility="{Binding InvalidPriceError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="Create service" Command="{Binding CreateServiceCommand}" HorizontalAlignment="Center" Padding="10" Margin="0 10 0 10"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
